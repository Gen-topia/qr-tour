# --- AWS RDS (MySQL) ---
DB_HOST=your-instance.xxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=change-me
DB_NAME=qr_tour
DB_SSL=1                 # RDS는 SSL 권장(1이면 사용)
DB_POOL_LIMIT=5         # 서버리스는 낮게

# --- 인증 ---
JWT_SECRET=change-me-to-a-long-random-string

# --- 소셜 로그인 (자세한 발급 절차는 login_template.md) ---
# 콜백 URL 생성 기준. 로컬은 비워두면 요청 origin 사용, 배포 시 반드시 실제 도메인 지정
APP_BASE_URL=http://localhost:3000
# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=57201ff6d0e5bfa509e0411a687e6331
# 보안 > Client Secret 을 '사용함'으로 켠 경우에만 입력
KAKAO_CLIENT_SECRET=
# 네이버 개발자센터 > 내 애플리케이션 > 개요
NAVER_CLIENT_ID=KM2ZzEJV4dWfua5wsf4_
NAVER_CLIENT_SECRET=B7UvDpzHsG

# 순서 강제(선택): 1이면 직전 미션 완료해야 다음 진입
ENFORCE_ORDER=0
